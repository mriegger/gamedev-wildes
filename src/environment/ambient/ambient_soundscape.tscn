[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://environment/ambient/ambient_soundscape.gd" id="1"]

[node name="AmbientSoundscape" type="Node"]
script = ExtResource("1")

[node name="BirdsPlayer" type="AudioStreamPlayer" parent="."]
bus = &"Ambient"

[node name="InsectsPlayer" type="AudioStreamPlayer" parent="."]
bus = &"Ambient"

[node name="TimerBirds" type="Timer" parent="."]
wait_time = 5.0
one_shot = true
autostart = false

[node name="TimerInsects" type="Timer" parent="."]
wait_time = 6.0
one_shot = true
autostart = false

[connection signal="timeout" from="TimerBirds" to="." method="_on_birds_timer_timeout"]
[connection signal="timeout" from="TimerInsects" to="." method="_on_insects_timer_timeout"]
