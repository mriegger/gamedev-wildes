[sub_resource type="Resource" id="helmet_right"]
script = ExtResource("4_visual")
mesh = SubResource("helmet_right_mesh")
local_transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.235, -0.02, 0)

[sub_resource type="BoxMesh" id="helmet_back_mesh"]
