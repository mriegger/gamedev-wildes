[ext_resource type="Material" path="res://inventory/equipment/materials/copper_armor_material.tres" id="5_material"]

[sub_resource type="Resource" id="defense"]
script = ExtResource("3_modifier")
id = &"copper_helmet_defense"
source_item_id = &"copper_helmet"
stat_id = &"defense"
amount = 1.0

[sub_resource type="BoxMesh" id="helmet_top_mesh"]
material = ExtResource("5_material")
size = Vector3(0.5, 0.08, 0.5)

[sub_resource type="Resource" id="helmet_top"]
script = ExtResource("4_visual")
mesh = SubResource("helmet_top_mesh")
local_transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.235, 0)

[sub_resource type="BoxMesh" id="helmet_left_mesh"]
