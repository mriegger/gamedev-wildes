[gd_resource type="Resource" script_class="ArmorDefinition" load_steps=16 format=3]

[ext_resource type="Script" path="res://inventory/equipment/armor_definition.gd" id="1_armor"]
[ext_resource type="Texture2D" path="res://inventory/equipment/icons/copper_helmet.svg" id="2_icon"]
