[gd_resource type="Resource" script_class="ArmorDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://equipment/armor/armor_definition.gd" id="1_armor"]
[ext_resource type="Texture2D" path="res://equipment/armor/sets/copper/icons/copper_shoes.svg" id="2_icon"]
[ext_resource type="Script" path="res://stats/stat_modifier.gd" id="3_modifier"]
[ext_resource type="Script" path="res://equipment/armor/armor_visual_part.gd" id="4_visual"]
[ext_resource type="Material" path="res://equipment/armor/sets/copper/copper_armor_material.tres" id="5_material"]
[ext_resource type="Resource" path="res://equipment/armor/sets/copper/copper_armor_set.tres" id="6_set"]
[ext_resource type="Resource" path="res://progression/definitions/common.tres" id="7_proficiency"]
[ext_resource type="Resource" path="res://items/rarity/definitions/common.tres" id="8_rarity"]
[ext_resource type="Resource" path="res://equipment/types/definitions/armor.tres" id="9_equipment_type"]

[sub_resource type="Resource" id="defense"]
script = ExtResource("3_modifier")
id = &"copper_shoes_defense"
source_id = &"copper_shoes"
stat_id = &"defense"
amount = 1.0

[sub_resource type="BoxMesh" id="shoe_mesh"]
material = ExtResource("5_material")
size = Vector3(0.255, 0.19, 0.33)

[sub_resource type="Resource" id="left_shoe"]
script = ExtResource("4_visual")
attachment = 6
mesh = SubResource("shoe_mesh")
local_transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.015, 0.0875, 0.04)

[sub_resource type="Resource" id="right_shoe"]
script = ExtResource("4_visual")
attachment = 7
mesh = SubResource("shoe_mesh")
local_transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.015, 0.0875, 0.04)

[resource]
script = ExtResource("1_armor")
id = &"copper_shoes"
display_name = "Copper Shoes"
description = "Copper armor that protects your feet. These boots were made for blocking."
icon = ExtResource("2_icon")
max_stack = 1
rarity = ExtResource("8_rarity")
proficiency = ExtResource("7_proficiency")
equipment_type = ExtResource("9_equipment_type")
stat_modifier_activation = 1
stat_modifiers = Array[ExtResource("3_modifier")]([SubResource("defense")])
armor_slot = 3
armor_set = ExtResource("6_set")
visual_parts = Array[ExtResource("4_visual")]([SubResource("left_shoe"), SubResource("right_shoe")])
