[gd_resource type="Theme" load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="Style_loading_track"]
bg_color = Color(1, 1, 1, 0.18)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[sub_resource type="StyleBoxFlat" id="Style_loading_fill"]
bg_color = Color(1, 1, 1, 0.94)
corner_radius_top_left = 2
corner_radius_top_right = 2
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

[resource]
ProgressBar/styles/background = SubResource("Style_loading_track")
ProgressBar/styles/fill = SubResource("Style_loading_fill")
