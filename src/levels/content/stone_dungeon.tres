[gd_resource type="Resource" script_class="LevelDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://levels/definitions/level_definition.gd" id="1_definition"]
[ext_resource type="Resource" path="res://levels/content/stone_dungeon_presentation.tres" id="2_presentation"]

[resource]
script = ExtResource("1_definition")
level_id = &"stone_dungeon"
presentation = ExtResource("2_presentation")
start_module_id = &"dungeon_start_chamber"
expansion_module_ids = Array[StringName]([&"dungeon_straight_hall", &"dungeon_corner_hall", &"dungeon_small_room", &"dungeon_large_room", &"dungeon_t_junction"])
cap_module_ids = Array[StringName]([&"dungeon_compact_dead_end", &"dungeon_dead_end_chamber"])
minimum_module_count = 8
maximum_module_count = 12
maximum_extent = Vector3i(96, 16, 96)
maximum_explored_states = 10000
