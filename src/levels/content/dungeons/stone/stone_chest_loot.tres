[gd_resource type="Resource" script_class="LootBundleDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://loot/loot_bundle_definition.gd" id="1_bundle"]
[ext_resource type="Script" path="res://loot/loot_bundle_entry_definition.gd" id="2_entry"]
[ext_resource type="Script" path="res://loot/loot_drop_definition.gd" id="3_drop"]
[ext_resource type="Resource" path="res://items/definitions/pumpkin.tres" id="4_pumpkin"]

[sub_resource type="Resource" id="PumpkinDrop"]
script = ExtResource("3_drop")
item = ExtResource("4_pumpkin")
minimum_count = 5
maximum_count = 10

[sub_resource type="Resource" id="PumpkinEntry"]
script = ExtResource("2_entry")
id = &"pumpkin"
drop = SubResource("PumpkinDrop")

[resource]
script = ExtResource("1_bundle")
id = &"stone_dungeon_chest"
max_rewards = 1
fixed_entries = Array[ExtResource("2_entry")]([SubResource("PumpkinEntry")])
